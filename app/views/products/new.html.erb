<%= form_with model: @product, local: true, url: products_path do |f| %>

    <h2>新商品登録</h2>


    <div class="field-wrapper">
  <div class="form-group">
  <%= f.label :title, "商品名" %>
  <%= f.text_field :title, class: "form-control" %>
  </div>
  <div class="form-group">
  <%= f.label :price, "価格" %>
  <%= f.number_field :price, class: "form-control", min: 1 %>
  </div>
  <div class="form-group">
  <%= f.label :description, "商品説明" %>
  <%= f.text_area :description, class: "form-control" %>
  </div>
  <div class="form-group">
  <%= f.label :stock, "在庫数" %>
  <%= f.number_field :stock, class: "form-control", min: 0 %>
  </div>

  <div class="actions">
  <%= f.submit "商品を登録する", class: "btn-center" %>
  </div>

<% end %>

</div>



<%= link_to "トップページへ", new_user_registration_path, class:"back-action" %>