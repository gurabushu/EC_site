<div class=header-wrapper>

  <h1>国内最大級ECサイト<br> Connect-lineへようこそ!</h1>

  <div class="header-login">
  <% if user_signed_in? %>
    <h2>ようこそ、<%= current_user.email %>さん</h2>
    <p>
        <%= link_to "ログアウト", destroy_user_session_path, data: { turbo_method: :delete }, class:"btn-element" %>
        <%= link_to "マイページ",user_path(current_user), class:"btn-element" %>
    </p>
  <% else %>
    <h2><%= link_to "ログイン", new_user_session_path, class:"btn-element" %></h2>
    <h2><%= link_to "新規登録", new_user_registration_path, class:"btn-element" %></h2>
  <% end %>
  </div>
</div>

<h2>商品一覧</h2>

<% if @products.empty? %>
<p class="text-center">登録された商品がありません</p>
<% else %>
<p>登録された商品が <%= @products.count %> 件あります</p>
<% end %>
<% @products.each do |p| %>
  <div class="product">
    <h2><%= link_to p.name, product_path(p) %></h2>
    <p>価格: <%= number_to_currency(p.price) %></p>
    <p>説明: <%= truncate(p.description, length: 100) %></p>
  </div>
<% end %>

